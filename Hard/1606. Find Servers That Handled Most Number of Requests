class Solution {
    public List<Integer> busiestServers(int k, int[] arrival, int[] load) {
        PriorityQueue<Integer> q = new PriorityQueue<>();
        PriorityQueue<long[]> busy = new PriorityQueue<>((x,y) -> Long.compare(x[0], y[0]));

        for(int i = 0; i < k ; i ++) {
            q.add(i);
        }
        int[] count = new int[k];
        int n = arrival.length;

        for(int i = 0; i < n; i ++) {
            while(!busy.isEmpty() && busy.peek()[0] <= arrival[i]) {
                int id = (int)busy.poll()[1];
                q.add(i + Math.floorMod(id - i, k));
            }
            if(q.isEmpty())
                continue;
            int id = q.poll() % k;
            count[id] ++;
            busy.add(new long[] {arrival[i] + load[i], id});

        }
        int max = 0;
        for(int i : count)
            max = Math.max(i, max);
        List<Integer> ans = new ArrayList<>();
        for(int i = 0; i < k; i ++) {
            if(count[i] == max)
                ans.add(i);
        }
        return ans;
    }
}