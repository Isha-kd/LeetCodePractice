class Solution {
    public int maxSum(List<Integer> nums, int k) {
        int n = nums.size();
        int[] arr = new int[31];
        for(int i = 0; i < n ; i ++) {
            for(int j = 0; j < 31; j ++) {
                if(((1 << j) & nums.get(i)) != 0)
                    arr[j] ++;
            }
        }
        int md = 1_000_000_007;
        long ans = 0;
        for(int i = 0; i < k; i ++) {
            long x = 0;
            for(int j = 0; j < 31; j ++) {
                if(arr[j] == 0)
                    continue;
                x += (1 << j);
                arr[j] --;
            }
            if(x == 0)
                break;
            x *= x;
            ans += x;
            ans %= md;
        }
        return (int) ans;


    }
}