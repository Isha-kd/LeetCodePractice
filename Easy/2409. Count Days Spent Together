class Solution {
    public int countDaysTogether(String arriveAlice, String leaveAlice, String arriveBob, String leaveBob) {
        int[] arr = {0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334};
        int aa = arr[(arriveAlice.charAt(0) - '0') * 10 + arriveAlice.charAt(1) - '0' -1] + (arriveAlice.charAt(3) - '0') * 10 +   arriveAlice.charAt(4) - '0';
        int la = arr[(leaveAlice.charAt(0) - '0') * 10 + leaveAlice.charAt(1) - '0' - 1] + (leaveAlice.charAt(3) - '0') * 10 +   leaveAlice.charAt(4) - '0';
        int ab = arr[(arriveBob.charAt(0) - '0') * 10 + arriveBob.charAt(1) - '0' - 1] + (arriveBob.charAt(3) - '0') * 10 +   arriveBob.charAt(4) - '0';
        int lb = arr[(leaveBob.charAt(0) - '0') * 10 + leaveBob.charAt(1) - '0' - 1] + (leaveBob.charAt(3) - '0') * 10 +   leaveBob.charAt(4) - '0';

        return Math.max(0, Math.min(lb, la) - Math.max(aa, ab) + 1);
    }
}