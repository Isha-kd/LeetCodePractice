class Solution {
    public String removeOuterParentheses(String s) {
        StringBuilder sb = new StringBuilder();
        int c = 0;
        for(char i : s.toCharArray()) {
            if(i == '(') {
                if(c != 0)
                    sb.append(i);
                c ++;
            } else {
                c --;
                if(c != 0)
                    sb.append(i);
            }
        }
        return sb.toString();
    }
}