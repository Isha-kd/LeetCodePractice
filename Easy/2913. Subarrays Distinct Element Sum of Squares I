class Solution {
    public int sumCounts(List<Integer> nums) {

        int n = nums.size();
        int ans = 0;
        for(int i = 0; i < n; i ++) {
            Map<Integer, Integer> map = new HashMap<>();
            for(int j = i; j < n; j ++) {
                map.put(nums.get(j), map.getOrDefault(nums.get(j), 0) + 1);
                ans += map.size() * map.size();
            }
        }
        return ans;
    }
}