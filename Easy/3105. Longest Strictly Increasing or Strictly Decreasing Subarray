class Solution {
    public int longestMonotonicSubarray(int[] nums) {
        int ans = 1;
        int n = nums.length;
        int i = 0;
        while(i < n - 1) {
            int j = i + 1;
            while(j < n && nums[j] > nums[j - 1])
                j ++;
            ans = Math.max(ans, j - i);
            i = j - 1;
            while(j < n && nums[j] < nums[j - 1])
                j ++;
            ans = Math.max(ans, j - i);
            while(j < n && nums[j] == nums[j - 1])
                j ++;
            i = j - 1;
        }
        return ans;
    }
}