class Solution {
    public boolean isValid(String s) {
        Stack<Character> stack = new Stack<>();
        for(char i : s.toCharArray()) {
            if(i == '(' || i == '[' || i == '{')
                stack.push(i);
            else {
                if(stack.isEmpty())
                    return false;
                else {
                    char ch = stack.pop();
                    if(ch == '(' && i != ')')
                        return false;
                    if(ch == '[' && i != ']')
                        return false;
                    if(ch == '{' && i != '}')
                        return false;
                }
            }
        }
        return stack.isEmpty();
    }
}