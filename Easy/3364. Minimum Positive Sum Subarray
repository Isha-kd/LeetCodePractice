class Solution {
    public int minimumSumSubarray(List<Integer> nums, int l, int r) {
        int ans = 100001;
        int n = nums.size();
        int[] prefix = new int[n];
        prefix[0] = nums.get(0);
        for(int i = 1; i < n; i ++) {
            prefix[i] = nums.get(i) + prefix[i - 1];
        }

        for(int i = l; i <= r; i ++) {
            if(prefix[i - 1] > 0)
                ans = Math.min(ans, prefix[i - 1]);
            for(int j = 1; j + i <= n; j ++) {
                int curr = prefix[j + i - 1] - prefix[j - 1];
                if(curr > 0)
                    ans = Math.min(ans, curr);
            }
        }
        if(ans == 100001)
            return  -1;
        return ans;
    }
}