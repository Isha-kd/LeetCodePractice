class Solution {
    public String[] createGrid(int m, int n) {
        String[] ans = new String[m];
        for(int i = 0; i < m - 1; i++) {
            StringBuilder s = new StringBuilder();
            s.append('.');
            for(int j = 1; j < n; j ++) {
                s.append('#');
            }
            ans[i] = s.toString();
        }
        StringBuilder s = new StringBuilder();
        for(int i = 0; i < n; i ++) {
                s.append('.');
            }
        ans[m-1] = s.toString();
        return ans;
    }
}