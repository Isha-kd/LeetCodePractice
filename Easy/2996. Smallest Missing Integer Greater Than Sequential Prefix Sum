class Solution {
    public int missingInteger(int[] nums) {
        int[] arr = new int[51];
        int sum = nums[0];
        int i = 1, n = nums.length;
        while(i < n && nums[i] == nums[i-1] + 1) {
            sum += nums[i ++];
        }
        i --;
        while(i < n)
            arr[nums[i ++]] = 1;
        for(i = sum; i < 51; i ++)
            if(arr[i] == 0)
                return i;
        return i;
    }
}