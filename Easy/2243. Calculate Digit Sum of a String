class Solution {
    public String digitSum(String s, int k) {
        int l = s.length();
        while(l > k) {
            int[] arr = new int[(l + k - 1) / k];
            for(int i = 0; i < l; i ++) {
                arr[i / k] += s.charAt(i) - '0';
            }
            StringBuilder sb = new StringBuilder();
            for(int i : arr)
                sb.append(i);
            s = sb.toString();
            l = s.length();
        }
        return s;
    }
}