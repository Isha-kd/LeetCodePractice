class Solution {
    public int maxLength(int[] nums) {
        int n = nums.length;
        int[] arr = new int[9];
        int ans = 2;
        int i = 0, j = 0;
        while(i < n && j < n) {
            int x = nums[j];
            if(x == 1) {
                j ++;
                ans = Math.max(ans, j - i);
                continue;
            }

            for(int d = 0; d < 9; d ++) {
                if(x % (d + 2) == 0)
                    arr[d] ++;
            }
            boolean flag = true;
            for(int d = 0; d < 9; d ++) {
                if(arr[d] > 1) {
                    flag = false;
                    break;
                }
            }
            while(!flag && i != j) {
                x = nums[i];
                if(x == 1) {
                    i ++;
                    continue;
                }
                flag = true;
                for(int d = 0; d < 9; d ++) {
                    if(x % (d + 2) == 0)
                        arr[d] --;
                    if(arr[d] > 1)
                        flag = false;
                }
                i ++;
            }
            ans = Math.max(ans, j - i + 1);
            j ++;
        }
        return ans;
    }
}