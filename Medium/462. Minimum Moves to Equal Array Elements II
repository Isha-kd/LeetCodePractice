class Solution {
    public int minMoves2(int[] nums) {
        Arrays.sort(nums);
        int n = nums.length;
        int ans = 0;
        int med = nums[n/2];
        for(int i = 0; i < n / 2; i ++) {
            ans -= nums[i];
        }
        for(int i = (n + 1) / 2 ; i < n; i ++) {
            ans += nums[i];
        }

        return ans;
    }
}