class Solution {

    int[] col = {0, 1, 0 , - 1};
    int[] row = { 1, 0, -1, 0};

    void dfs(int[][] grid, int i, int j, boolean[][] vis) {
        vis[i][j] = true;

        int n = grid.length, m = grid[0].length;

        for(int x = 0; x < 4; x ++) {
            int a = i + row[x], b = j + col[x];
            if(a < n && b < m && a > 0 && b > 0 && grid[a][b] == 0 && !vis[a][b])
                dfs(grid, a, b, vis);
        }
        return;
    }
    public int closedIsland(int[][] grid) {
        int n = grid.length, m = grid[0].length;
        boolean[][] vis = new boolean[n][m];

        for(int i = 0; i < n ; i ++) {
            if(!vis[i][0] && grid[i][0] == 0)
                dfs(grid, i, 0, vis);
            if(!vis[i][m-1] && grid[i][m - 1] == 0)
                dfs(grid, i, m - 1, vis);
        }
        for(int i = 0; i < m ; i ++) {
            if(!vis[0][i] && grid[0][i] == 0)
                dfs(grid, 0, i, vis);
            if(!vis[n - 1][i] && grid[n - 1][i] == 0)
                dfs(grid, n - 1, i, vis);
        }

        int ans = 0;
        for(int i = 1; i < n - 1; i ++) {
            for(int j = 1; j < m - 1; j ++) {
                if(!vis[i][j] && grid[i][j] == 0) {
                    ans ++;
                    dfs(grid, i, j, vis);
                }

            }
        }

        return ans;
    }
}