class Solution {

    int[] arr;

    int helper(int k , int max) {
        for(int i : arr) {
            if(k < 0 || i <= max)
                return k;
            k -= i - max;
        }
        return k;
    }

    void reverse() {
        int i = 0, j = arr.length - 1;
        while(i < j) {
            int k = arr[i];
            arr[i] = arr[j];
            arr[j] = k;
            i ++;
            j --;
        }
    }

    public long minSumSquareDiff(int[] nums1, int[] nums2, int k1, int k2) {

        int n = nums1.length;
        arr = new int[n];
        for(int i = 0; i < n; i ++) {
            arr[i] = Math.abs(nums1[i] - nums2[i]);
        }

        Arrays.sort(arr);

        reverse();

        int k = k1 + k2;
        int low = Math.max(0 , arr[0] - k), high = arr[0];
        int rem = 0;

        while(high >= low) {
            int mid = low + (high - low) / 2;
            int val = helper(k, mid);
            if(val > 0) {
                rem = val;
                high = mid - 1;
            } else if(val == 0) {
                rem = 0;
                low = mid;
                break;
            } else
                low = mid + 1;
        }
        long ans = 0;
        if(low == 0)
            return 0;
        for(int i = 0; i < n; i ++) {
            if(i < rem)
                ans += (low - 1l) * (low - 1l);
            else if(arr[i] > low)
                ans += 1l * low * low;
            else
                ans += 1l * arr[i] * arr[i];
        }
        return ans;


    }
}