class Solution {
    public int scoreOfParentheses(String s) {
        int ans = 0;
        int c = 0;
        int ind = -1;
        for(int i = 0; i < s.length(); i ++) {
            if(s.charAt(i) == '(') {
                c ++;
                ind = i;
            } else {
                c --;
                if(ind == i - 1)
                ans += (1 << c);
            }
        }
        return ans;
    }
}