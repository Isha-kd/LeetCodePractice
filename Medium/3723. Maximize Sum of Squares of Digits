class Solution {
    public String maxSumOfSquares(int num, int sum) {
        if(sum>9*num) return "";
        StringBuilder s=new StringBuilder();
        for(int i=0;i<num;i++){
            int n=Math.min(9,sum);
            s.append(n);
            sum-=Math.min(9,sum);
        }
        return s.toString();
    }
}