class Solution {
    void helper(List<String> ans,int open,int close,StringBuilder s){
        if(close==0){
            ans.add(s.toString());
            return;
        }
        if(open>0){
            helper(ans,open-1,close,s.append('('));
            s.deleteCharAt(s.length()-1);
        }
        if(close>open){
            helper(ans,open,close-1,s.append(')'));
            s.deleteCharAt(s.length()-1);
        }
        return;
    }
    public List<String> generateParenthesis(int n) {
        List<String> ans=new ArrayList<>();
        int open=n,close=n;
        StringBuilder s=new StringBuilder();
        helper(ans,open,close,s);
        return ans;
    }
}