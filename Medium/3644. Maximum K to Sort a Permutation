class Solution {
    public int sortPermutation(int[] nums) {
        int ans;
        int i = 0, n = nums.length;
        while(i < n && nums[i] == i)
            i ++;
        if(i == n)
            return 0;
        ans = i;
        while(i < n) {
            if(nums[i] != i)
                ans &= i;
            i ++;
        }
        return ans;
    }
}