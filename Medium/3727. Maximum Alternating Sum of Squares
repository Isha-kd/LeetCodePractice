class Solution {
    public long maxAlternatingSum(int[] nums) {
        int n=nums.length;
        for(int i=0;i<n;i++){
            nums[i]=Math.abs(nums[i]);
        }
        Arrays.sort(nums);
        long even=0,odd=0;
        for(int i=0;i<n/2;i++){
            even+=nums[i]*(long)nums[i];
        }
        for(int i=n/2;i<n;i++){
            odd+=nums[i]*(long)nums[i];
        }
        return odd-even;
    }
}