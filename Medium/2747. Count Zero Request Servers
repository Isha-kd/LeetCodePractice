class Solution {
    public int[] countServers(int n, int[][] logs, int x, int[] queries) {
        int max = 0;
        for(int i : queries) {
            max = Math.max(i, max);
        }
        int[] arr = new int[max + 2];

        Arrays.sort(logs,(a, b) -> {
            if(a[0] == b[0])
                return a[1] - b[1];
            return a[0] - b[0];
        });

        int l = logs.length;
        for(int i = 0; i < l; i ++) {
            int id = logs[i][0];
            int time = logs[i][1];
            if(i > 0 && id == logs[i-1][0] && time <= logs[i-1][1] + x) {
                if(logs[i - 1][1] + x <= max) {
                    arr[logs[i - 1][1] + 1 + x] ++;
                }
            } else {
                if(time <= max)
                    arr[time] ++;
            }
            if(time + x <= max) {
                arr[time + 1 + x] --;
            }
        }

        for(int i = 1; i < max + 1; i ++) {
            arr[i] += arr[i - 1];
        }

        l = queries.length;
        int[] ans = new int[l];
        for(int i = 0; i < l; i ++) {
            ans[i] = n - arr[queries[i]];
        }

        return ans;

    }
}