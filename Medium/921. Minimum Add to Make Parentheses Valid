class Solution {
    public int minAddToMakeValid(String s) {
        int ans = 0;
        int l = s.length();
        int c = 0;
        for(int i = 0; i < l; i ++) {
            if(s.charAt(i) == ')') {
                if(c > 0)
                    c --;
                else
                    ans ++;
            }
            else
                c ++;
        }
        ans += c;
        return ans;
    }
}