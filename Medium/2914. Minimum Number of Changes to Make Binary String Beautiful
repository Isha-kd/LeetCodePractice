class Solution {
    public int minChanges(String s) {
        int l = s.length();
        int ans = 0;
        int c = 1;
        int prev = 0;
        for(int i = 1; i < l; i ++) {
            if(s.charAt(i) == s.charAt(i - 1))
                c ++;
            else {
                if(prev == 1) {
                    ans ++;
                    if((c & 1) == 0)
                        prev = 1;
                    else
                        prev = 0;
                } else {
                    prev = c & 1;
                }
                c = 1;
            }
        }
        if(prev == 1 || (c & 1) == 1)
            ans ++;
        return ans;
    }
}