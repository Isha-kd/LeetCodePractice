class Solution {
    public int numOfSubarrays(int[] arr) {
        int even = 1, odd = 0;
        int md = 1_000_000_007;
        long ans = 0;
        int sum = 0;
        for(int i : arr) {
            sum += i;
            if((sum & 1) == 0) {
                ans += odd;
                even ++;
            } else {
                ans += even;
                odd ++;
            }
            ans %= md;
        }
        return (int)ans;
    }
}