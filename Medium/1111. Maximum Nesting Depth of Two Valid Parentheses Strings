class Solution {
    public int[] maxDepthAfterSplit(String seq) {
        int l = seq.length();
        int c = 0, back = 0;
        int[] ans = new int[l];
        for(int i = 0; i < l; i ++) {
            if(seq.charAt(i) == '(') {
                ans[i] = (c & 1);
                c ++;

            } else
                c --;

            if(seq.charAt(l - i - 1) == ')') {
                ans[l - i - 1] = (back & 1);
                back ++;
            } else
                back --;
        }
        return ans;

    }
}