class Solution {
    public int minInsertions(String s) {
        int ans = 0;
        int c = 0;
        for(int i = 0; i < s.length(); i ++) {
            if(s.charAt(i) == ')') {
                c --;
            } else {
                if(c < 0) {
                    ans += (- c + 1) / 2;
                    ans += (-c & 1);
                    c = 0;
                } else if((-c & 1) == 1) {
                    ans ++;
                    c --;
                }

                c += 2;
            }
        }
        if(c > 0)
            ans += c;
        else {
            ans += (- c + 1) / 2;
            ans += (-c & 1);
        }
        return ans;
    }
}