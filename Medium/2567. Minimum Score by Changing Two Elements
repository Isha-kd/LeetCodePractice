class Solution {
    public int minimizeSum(int[] nums) {
        if(nums.length == 3)
            return 0;
        int[] max = new int[3];
        int[] min = new int[3];
        Arrays.fill(min, Integer.MAX_VALUE);

        for(int i : nums) {
            if(i > max[0]) {
                max[2] = max[1];
                max[1] = max[0];
                max[0] = i;
            } else if(i > max[1]) {
                max[2] = max[1];
                max[1] = i;
            } else if(i > max[2]) {
                max[2] = i;
            }
            if(i < min[0]) {
                min[2] = min[1];
                min[1] = min[0];
                min[0] = i;
            } else if(i < min[1]) {
                min[2] = min[1];
                min[1] = i;
            } else if(i < min[2]) {
                min[2] = i;
            }
        }
        return Math.min(Math.min(max[0] - min[2], Math.abs(max[2] - min[0])), max[1] - min[1]);
    }
}