class Solution {
    public int minimumPushes(String word) {
        int[] arr = new int[26];
        int l = word.length();
        for(int i = 0; i < l; i ++)
            arr[word.charAt(i) - 'a'] ++;
        Arrays.sort(arr);
        int ans = 0;
        for(int i = 0; i < 26; i ++) {
            ans += ((i + 8)/8) * arr[25 - i];
        }
        return ans;
    }
}