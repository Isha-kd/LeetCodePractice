class Solution {
    public int minOperations(int[] nums, int x) {
        Map<Integer, Integer> map = new HashMap<>();
        int min = Integer.MAX_VALUE;
        int s = 0, n = nums.length;
        for(int i = 0; i < n; i ++) {
            s += nums[i];
            if(s == x) {
                min = i + 1;
                break;
            }
            if(s > x)
                break;
            map.put(s, i + 1);
        }
        Map<Integer, Integer> map2 = new HashMap<>();
        s = 0;
        for(int i = 1; i <= n; i ++) {
            s += nums[n - i];
            if(map.containsKey(x - s) && map.get(x - s) + i <= n)
                min = Math.min(min, i + map.get(x - s));
            if(s == x) {
                min = Math.min(min, i);
                break;
            }
            if(s > x)
                break;
            map2.put(s, i);
        }
        s = 0;
        for(int i = 0; i < n; i ++) {
            s += nums[i];
            if(map2.containsKey(x - s) && map2.get(x - s) + i + 1 <= n) {
                min = Math.min(min, i + 1 + map2.get(x - s));
            }
            if(s > x)
                break;
        }
        return min == Integer.MAX_VALUE ? -1 : min;

    }
}